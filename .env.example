# ─── IRIS v2 — Environment Variables ─────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── LLM Provider (pick one) ─────────────────────────────────────────────
# Options: aevibron | ollama | groq | openai
IRIS_LLM_BACKEND=ollama

# Default models (optional — falls back to backend default)
IRIS_LLM_MODEL=
IRIS_LLM_FAST_MODEL=
IRIS_LLM_DEEP_MODEL=

# ─── Backend 1: Aevibron-gateway ──────────────────────────────────────────
AEVIBRON_BASE_URL=https://aevibron-gateway.vercel.app/api/v1
AEVIBRON_API_KEY=
AEVIBRON_ACCESS_TOKEN=

# ─── Backend 2: Ollama (local, free, no API key) ────────────────────────
# Install Ollama: curl -fsSL https://ollama.com/install.sh | sh
# Pull a model:   ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434

# ─── Backend 3: Groq (fast cloud, free tier) ─────────────────────────────
# Get key at: https://console.groq.com
GROQ_API_KEY=

# ─── Backend 4: OpenAI-compatible cloud ─────────────────────────────────
# Works with: OpenAI, OpenRouter, Together, Anyscale, vLLM, llama.cpp
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── GitHub (for autonomous git operations) ─────────────────────────────
GITHUB_TOKEN=
GITHUB_USERNAME=

# ─── Vercel (for autonomous deployment) ─────────────────────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ─── Flask ───────────────────────────────────────────────────────────────
PORT=5000
DEBUG=False
FLASK_SECRET_KEY=change-me-to-32-random-chars

# ─── Aevibron integration (optional — for SSO with Aevibron) ────────────
AEVIBRON_SESSION_COOKIE_NAME=aevibron_session
AEVIBRON_ADMIN_ROUTE=

# ─── Phone bridge (ADB — for Android device control) ────────────────────
PHONE_BRIDGE_ENABLED=False
ADB_DEVICE_ID=

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=True

# ─── Owner ───────────────────────────────────────────────────────────────
OWNER_NAME=Infinite Vybeflix
OWNER_ALIAS=Infinite
OWNER_EMAIL=aevibron@gmail.com
