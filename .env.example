# IRIS v2 — Environment Variables
# ──────────────────────────────────────────────────────────────
# Most settings are configured from the Settings UI at /settings
# These env vars are for the SERVER ADMIN (not end users).
# End users pick their LLM provider + enter keys from the UI.
#
# ALL VARIABLES ARE OPTIONAL. IRIS boots with zero env vars set.
# Users configure their API keys from the Settings page after deploy.

# ─── LLM Provider (server-level default — users can override from UI) ────
# Options: auto | aevibron | ollama_local | ollama_cloud | groq | openai | custom
# "auto" = IRIS probes all configured providers and picks the first working one
IRIS_LLM_BACKEND=auto

# ─── Aevibron Gateway (recommended) ──────────────────────────────────────
# The URL can be set here (server admin) OR from the Settings UI (per-user)
# If set here, it's the default for all users. Users can override from UI.
AEVIBRON_BASE_URL=https://aevibron-gateway.vercel.app/api/v1
AEVIBRON_API_KEY=
AEVIBRON_ACCESS_TOKEN=

# ─── Ollama (local) ───────────────────────────────────────────────────────
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull:    ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434

# ─── Groq ────────────────────────────────────────────────────────────────
# Get key at: https://console.groq.com
GROQ_API_KEY=

# ─── OpenAI / OpenAI-compatible cloud ─────────────────────────────────────
# Works with: OpenAI, OpenRouter, Together, Anyscale, vLLM, llama.cpp
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── GitHub (for autonomous git operations — optional) ───────────────────
# Set from Settings UI or here. Not required for IRIS to work.
GITHUB_TOKEN=
GITHUB_USERNAME=

# ─── Vercel (for autonomous deployment — optional) ───────────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ─── Cloudflare (for Cloudflare Pages deploys — optional) ────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ─── Flask ───────────────────────────────────────────────────────────────
PORT=5000
DEBUG=False
FLASK_SECRET_KEY=change-me-to-32-random-chars

# ─── Aevibron SSO (optional — for Aevibron integration) ──────────────────
AEVIBRON_SESSION_COOKIE_NAME=aevibron_session
AEVIBRON_ADMIN_ROUTE=

# ─── Phone bridge (ADB — for Android device control — optional) ──────────
PHONE_BRIDGE_ENABLED=False
ADB_DEVICE_ID=

# ─── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=True

# ─── Owner ───────────────────────────────────────────────────────────────
OWNER_NAME=Infinite Vybeflix
OWNER_ALIAS=Infinite
OWNER_EMAIL=aevibron@gmail.com

# ─── Database (optional — SQLite by default, PostgreSQL for production) ──
# DATABASE_URL=postgresql://user:pass@host:5432/iris?sslmode=require
DATABASE_URL=
LOCAL_DB_PATH=sqlite:///data/iris_v9.db
USE_POSTGRES=False

# ─── Redis (optional — for multi-instance rate limiting) ─────────────────
REDIS_URL=
SWARM_ENABLED=False

# ─── Proactive engine ────────────────────────────────────────────────────
PROACTIVE_MODE=True
PROACTIVE_CHECK_INTERVAL=300
CONTEXT_AWARENESS=True
CONTINUOUS_LEARNING=True
EMOTIONAL_INTELLIGENCE=True
